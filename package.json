{
  "name": "frozen-support-system",
  "version": "1.0.0",
  "private": true,
  "description": "Modern Arabic Discord support and ticket system for Frozen, built with TypeScript, discord.js, and Supabase PostgreSQL.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "deploy:commands": "tsx src/deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "pg": "^8.16.3",
    "pino": "^9.9.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
